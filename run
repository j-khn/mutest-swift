#!/usr/bin/env python3
"""Interactive local launcher for swift-mutation-testing."""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path


ROOT = Path(__file__).resolve().parent


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        prog="./run",
        description="Run mutest-swift locally. Xcode settings are detected and prompted for when missing.",
        epilog="""Xcode test selection:
  With no test selectors or --test-target, run the scheme's full test plan.
  Repeat --test-target to run all tests from multiple targets.
  Add --test-file, --test-suite, and/or --test-name to add only matching tests
  from any test target in the chosen scheme. These selections are combined;
  duplicates run once. If a name is ambiguous, use TargetName::selector.

Examples:
  ./run /path/to/App.xcodeproj
  ./run /path/to/App.xcodeproj --scheme App --test-target AppTests --destination-simulator 'platform=iOS Simulator,name=iPhone 17,OS=latest'
  ./run /path/to/App.xcodeproj --test-target A --test-target B --test-file CTests.swift --test-suite 'ETests::Suite1' --test-name 'DTests::testOne'
  ./run /path/to/App.xcodeproj --workers 2 --mutation-source A.swift --mutation-source B.swift --test-file ATests.swift --test-file BTests.swift""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    result.add_argument("project", nargs="?", default=".", help="iOS/iPadOS package inside an Xcode project, .xcodeproj, .xcworkspace, or folder containing one (default: current folder)")
    xcode_group = result.add_argument_group("Xcode run")
    xcode_group.add_argument("--scheme", help="Xcode scheme; prompted if missing")
    xcode_group.add_argument("--test-target", dest="test_targets", action="append", default=[], metavar="NAME", help="Xcode test target to run in full; repeat for more targets")
    xcode_group.add_argument("--target", dest="test_targets", action="append", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    xcode_group.add_argument("--destination-simulator", dest="destination", metavar="VALUE", help="iOS Simulator for Xcode tests, e.g. 'platform=iOS Simulator,name=iPhone 17,OS=latest' (prompted if omitted)")
    xcode_group.add_argument("--destination", dest="destination", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    xcode_group.add_argument("--workers", dest="parallelism", type=positive_int, default=2, metavar="COUNT", help="number of simultaneous mutation workers (default: 2)")
    for alias in ("--parallelism", "--parallelization"):
        xcode_group.add_argument(alias, dest="parallelism", type=positive_int, default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    mutation_group = result.add_argument_group("Code to mutate")
    mutation_group.add_argument("--mutation-source", dest="source", action="append", default=[], metavar="PATH", help="production Swift file/folder; repeat once per path")
    mutation_group.add_argument("--source", dest="source", action="append", default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    test_group = result.add_argument_group(
        "Tests to run",
        "A file, suite, or test adds matches from any target in the chosen scheme. Each --test-target adds every test in that target; filters and targets are combined, duplicates run once.",
    )
    test_group.add_argument("--test-file", dest="test_files", action="append", default=[], metavar="PATH", help="file containing tests; repeat once per file")
    test_group.add_argument("--target-file", dest="test_files", action="append", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    test_group.add_argument("--test-suite", dest="suite", action="append", default=[], metavar="NAME", help="suite grouping name or @Suite display name; repeat once per suite")
    test_group.add_argument("--suite", dest="suite", action="append", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    test_group.add_argument("--test-name", dest="tests", action="append", default=[], metavar="NAME", help="test function or custom test name; repeat once per test")
    for alias in ("--test", "--target-tests"):
        test_group.add_argument(alias, dest="tests", action="append", default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    options_group = result.add_argument_group("Other options")
    options_group.add_argument("--operators", help="comma-separated operators")
    options_group.add_argument("--operator-tier", default="experimental", choices=("experimental", "all"), help="operator tier (default: experimental)")
    options_group.add_argument("--xcodebuild-arg", action="append", default=[], help="Xcode build setting NAME=VALUE; repeatable")
    options_group.add_argument("--output", help="report directory")
    options_group.add_argument("--no-cache", action="store_true", help="disable cached verdicts")
    options_group.add_argument("--no-resume", action="store_true", help="do not resume prior verdicts")
    options_group.add_argument("--validate", action="store_true", help="check project and selectors without running mutation tests")
    return result


def positive_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a positive integer") from error
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def ask_choice(title: str, choices: list[str], default_first: bool = False) -> str:
    choices = list(dict.fromkeys(choice for choice in choices if choice))
    if not choices:
        raise RuntimeError(f"Could not find choices for {title.lower()}.")
    if len(choices) == 1:
        print(f"{title} {choices[0]}")
        return choices[0]
    if not sys.stdin.isatty():
        raise RuntimeError(f"{title} is ambiguous. Pass it as a command-line option.")
    print(f"{title} (Press Enter to choose the first option)" if default_first else title)
    for index, choice in enumerate(choices, 1):
        print(f"  {index}- {choice}")
    while True:
        prompt = "Choose a number [1]: " if default_first else "Choose a number: "
        answer = input(prompt).strip()
        if default_first and not answer:
            return choices[0]
        if answer.isdigit() and 1 <= int(answer) <= len(choices):
            return choices[int(answer) - 1]
        print(f"Enter a number from 1 to {len(choices)}.")


def ask_multiple_choices(title: str, choices: list[str], default_first: bool = True) -> list[str]:
    choices = list(dict.fromkeys(choice for choice in choices if choice))
    if not choices:
        raise RuntimeError(f"Could not find choices for {title.lower()}.")
    if len(choices) == 1:
        return choices
    if not sys.stdin.isatty():
        raise RuntimeError(f"{title} is ambiguous. Pass one or more --test-target options.")
    print(title)
    for index, choice in enumerate(choices, 1):
        print(f"  {index}- {choice}")
    default = " [1]" if default_first else ""
    while True:
        answer = input(f"Choose number(s) separated by commas{default}: ").strip()
        if not answer and default_first:
            return [choices[0]]
        try:
            indices = [int(part.strip()) for part in answer.split(",")]
        except ValueError:
            indices = []
        if indices and all(1 <= index <= len(choices) for index in indices):
            return list(dict.fromkeys(choices[index - 1] for index in indices))
        print(f"Enter one or more numbers from 1 to {len(choices)}, separated by commas.")


def discover_project(raw_path: str) -> tuple[str, Path]:
    path = Path(raw_path).expanduser().resolve()
    if not path.exists():
        raise RuntimeError(f"Project path does not exist: {path}")
    # Xcode project and workspace bundles are directories on disk.
    if path.suffix in (".xcodeproj", ".xcworkspace"):
        return ("xcode-project" if path.suffix == ".xcodeproj" else "xcode-workspace", path)
    if not path.is_dir():
        raise RuntimeError(f"Not a project folder or Xcode project: {path}")
    if (path / "Package.swift").is_file():
        # iOS/iPadOS package tests need Xcode's simulator runner. `swift test`
        # executes on the Mac host and can fail for packages using Xcode-only APIs.
        for parent in (path, *path.parents):
            workspaces = sorted(parent.glob("*.xcworkspace"))
            projects = sorted(parent.glob("*.xcodeproj"))
            candidates = workspaces or projects
            if candidates:
                selected = ask_choice(
                    "Which Xcode project or workspace do you want to run?",
                    [str(candidate) for candidate in candidates],
                )
                selected_path = Path(selected)
                return ("xcode-workspace" if selected_path.suffix == ".xcworkspace" else "xcode-project", selected_path)
        raise RuntimeError(
            f"No enclosing .xcodeproj or .xcworkspace found for package {path}. "
            "iOS/iPadOS tests need to run through Xcode on a simulator; pass the containing Xcode project or workspace."
        )

    candidates: list[Path] = []
    for current, dirs, _ in os.walk(path):
        current_path = Path(current)
        dirs[:] = [name for name in dirs if name not in {".git", ".build", ".build-xcode", "Pods", "Carthage", "DerivedData"}]
        for name in list(dirs):
            child = current_path / name
            if name.endswith(".xcworkspace"):
                candidates.append(child)
                dirs.remove(name)
            elif name.endswith(".xcodeproj"):
                candidates.append(child)
                dirs.remove(name)
    workspaces = [candidate for candidate in candidates if candidate.suffix == ".xcworkspace"]
    candidates = workspaces or [candidate for candidate in candidates if candidate.suffix == ".xcodeproj"]
    if not candidates:
        raise RuntimeError(f"No Package.swift, .xcodeproj, or .xcworkspace found under {path}")
    selected = ask_choice("Which Xcode project do you want to run?", [str(candidate) for candidate in candidates])
    selected_path = Path(selected)
    return ("xcode-workspace" if selected_path.suffix == ".xcworkspace" else "xcode-project", selected_path)


def xcode_list(kind: str, path: Path) -> dict:
    option = "-workspace" if kind == "xcode-workspace" else "-project"
    result = subprocess.run(
        ["xcodebuild", "-list", "-json", option, str(path)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"xcodebuild could not read {path}:\n{detail}")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"xcodebuild returned unreadable project information for {path}") from error


def schemes_from(project_info: dict) -> list[str]:
    names: list[str] = []
    for key in ("workspace", "project"):
        section = project_info.get(key, {})
        if isinstance(section, dict):
            names.extend(section.get("schemes", []))
    for project in project_info.get("projects", {}).values():
        if isinstance(project, dict):
            names.extend(project.get("schemes", []))
    unique_names = list(dict.fromkeys(names))
    preferred_order = {
        "MutationTest": 0,
        "CheckoutDomain": 1,
        "CheckoutInventory": 2,
        "CheckoutShipping": 3,
        "CheckoutCustomer": 4,
    }
    return sorted(unique_names, key=lambda name: (preferred_order.get(name, len(preferred_order)), name.casefold()))


def target_names(project_info: dict) -> list[str]:
    names: list[str] = []
    for key in ("project",):
        section = project_info.get(key, {})
        if isinstance(section, dict):
            names.extend(section.get("targets", []))
    for project in project_info.get("projects", {}).values():
        if isinstance(project, dict):
            names.extend(project.get("targets", []))
    return list(dict.fromkeys(names))


def test_targets(project_path: Path, project_info: dict, scheme: str) -> list[str]:
    scheme_files = list(project_path.rglob(f"{scheme}.xcscheme"))
    names: list[str] = []
    test_plans: list[Path] = []
    for file in scheme_files:
        try:
            root = ET.parse(file).getroot()
        except (ET.ParseError, OSError):
            continue
        for reference in root.iter("TestableReference"):
            for buildable in reference.iter("BuildableReference"):
                name = buildable.attrib.get("BlueprintName")
                if name:
                    names.append(name)
        for reference in root.iter("TestPlanReference"):
            plan_name = reference.attrib.get("reference", "").split(":")[-1]
            if plan_name.endswith(".xctestplan"):
                test_plans.append(project_path.parent / plan_name)
    for plan in test_plans:
        try:
            plan_data = json.loads(plan.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        for test_target in plan_data.get("testTargets", []):
            target = test_target.get("target", {})
            if target.get("name"):
                names.append(target["name"])
    if names:
        return list(dict.fromkeys(names))
    all_targets = target_names(project_info)
    likely_tests = [name for name in all_targets if re.search(r"(?:tests|uitests)$", name, re.IGNORECASE)]
    return likely_tests


def package_test_targets(package_path: Path) -> list[str]:
    if not (package_path / "Package.swift").is_file():
        return []
    result = subprocess.run(
        ["swift", "package", "--package-path", str(package_path), "dump-package"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        return []
    try:
        package = json.loads(result.stdout)
    except json.JSONDecodeError:
        return []
    return [target["name"] for target in package.get("targets", []) if target.get("type") == "test" and target.get("name")]


def find_packages(project_path: Path) -> list[tuple[Path, list[str]]]:
    root = project_path.parent if project_path.suffix in (".xcodeproj", ".xcworkspace") else project_path
    packages: list[tuple[Path, list[str]]] = []
    for current, dirs, files in os.walk(root):
        dirs[:] = [name for name in dirs if name not in {".git", ".build", ".build-xcode", ".swift-mutation-testing", "Pods", "Carthage", "DerivedData"}]
        if "Package.swift" in files:
            package_path = Path(current)
            targets = package_test_targets(package_path)
            if targets:
                packages.append((package_path, targets))
            dirs[:] = []
    return packages


def simulator_destinations() -> list[tuple[str, str]]:
    result = subprocess.run(["xcrun", "simctl", "list", "devices", "available", "-j"], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode != 0:
        raise RuntimeError("Cannot list iOS simulators. Install an iOS Simulator runtime in Xcode.")
    inventory = json.loads(result.stdout)
    entries: list[tuple[tuple[int, ...], str, str]] = []
    for runtime, devices in inventory.get("devices", {}).items():
        if ".iOS-" not in runtime:
            continue
        match = re.search(r"iOS-(\d+)-(\d+)(?:-(\d+))?", runtime)
        version = tuple(int(part or 0) for part in match.groups()) if match else (0, 0, 0)
        for device in devices:
            device_type = device.get("deviceTypeIdentifier", "")
            name = device.get("name", "")
            # Worker simulators are temporary clones owned by mutest-swift. They
            # must not be offered as the user's base destination on the next run.
            if name.startswith("mutest-") and re.search(r"-worker-\d+$", name):
                continue
            if device.get("isAvailable") is False or not any(kind in device_type for kind in ("iPhone", "iPad")):
                continue
            name = f"{name or 'iPhone'} (iOS {'.'.join(map(str, version[:2]))})"
            destination = f"platform=iOS Simulator,id={device['udid']}"
            entries.append((version, name, destination))
    if not entries:
        raise RuntimeError("No available iPhone or iPad simulators found. Install an iOS Simulator in Xcode.")
    latest = max(entry[0] for entry in entries)
    return [(name, destination) for version, name, destination in entries if version == latest]


def choose_destination() -> str:
    choices = simulator_destinations()
    labels = [name for name, _ in choices]
    selected = ask_choice("Which simulator do you want to use?", labels, default_first=True)
    return dict(choices)[selected]


def common_arguments(args: argparse.Namespace, include_xcodebuild_args: bool = True, default_source: str | None = None) -> list[str]:
    command = ["--workers", str(args.parallelism), "--operator-tier", args.operator_tier]
    source_values = args.source or ([default_source] if default_source else [])
    selectors = [("--mutation-source", source_values), ("--test-file", args.test_files), ("--test-suite", args.suite), ("--test-name", args.tests)]
    if include_xcodebuild_args:
        selectors.append(("--xcodebuild-arg", args.xcodebuild_arg))
    for option, values in selectors:
        for value in values:
            command += [option, value]
    if args.operators:
        command += ["--operators", args.operators]
    if args.no_cache:
        command.append("--no-cache")
    if args.no_resume:
        command.append("--no-resume")
    return command


def execute_task(task: dict[str, str], args: argparse.Namespace, destination: str | None, output: str | None) -> int:
    command = ["validate" if args.validate else "run", "--project", task["path"], "--project-kind", task["kind"]]
    if task["kind"] != "swift-package":
        command += ["--scheme", task["scheme"]]
        for target in task.get("targets", []):
            command += ["--test-target", target]
        command += ["--destination-simulator", destination or ""]
    command += common_arguments(
        args,
        include_xcodebuild_args=task["kind"] != "swift-package",
        default_source=task.get("source"),
    )
    if output:
        command += ["--output", output]
    title = task.get("name", task["path"])
    print(f"\n[run] Starting {title}…", flush=True)
    executable = ["swift", "run", "--package-path", str(ROOT), "swift-mutation-testing", *command]
    process = subprocess.Popen(executable, start_new_session=True)
    try:
        return process.wait()
    except KeyboardInterrupt:
        print("\n[run] Cancelling mutation testing; waiting for simulator cleanup…", flush=True)
        previous_handler = signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            try:
                os.killpg(process.pid, signal.SIGINT)
            except ProcessLookupError:
                pass
            process.wait()
            # `swift run` can exit before its executable finishes handling the
            # cancellation. Keep the launcher alive until that process group is gone.
            while True:
                try:
                    os.killpg(process.pid, 0)
                except ProcessLookupError:
                    break
                time.sleep(0.2)
        finally:
            signal.signal(signal.SIGINT, previous_handler)
        return 130


def run(args: argparse.Namespace) -> int:
    if any("/" in target or "\\" in target or target.lower().endswith(".swift") for target in args.test_targets):
        raise RuntimeError(
            "--test-target values must be Xcode test target names, not Swift files or folders. "
            "Use --mutation-source PATH for code files."
        )

    print(f"[run] Detecting project at {Path(args.project).expanduser()}…", flush=True)
    kind, project_path = discover_project(args.project)
    if kind == "swift-package":
        if any((args.scheme, args.test_targets, args.destination)):
            print("Note: scheme, test target, and destination are only used for Xcode projects.")
        task = {"kind": kind, "path": str(project_path), "name": project_path.name}
        if args.output:
            output = args.output
        else:
            output = None
        print("Test scope: full configured package" if not (args.test_files or args.suite or args.tests) else "Test scope: selected tests", flush=True)
        print("Mutation scope: all discovered source files" if not args.source else f"Mutation scope: {', '.join(args.source)}", flush=True)
        return execute_task(task, args, None, output)

    print(f"[run] Querying Xcode schemes for {project_path}…", flush=True)
    info = xcode_list(kind, project_path)
    schemes = schemes_from(info)
    if not schemes:
        raise RuntimeError("No shared Xcode schemes found. Open the project in Xcode and mark its scheme as Shared.")
    print("[run] Finding Swift package test targets…", flush=True)
    packages = find_packages(project_path)
    package_map = {path.name: (path, targets) for path, targets in packages}
    for path, targets in packages:
        for target in targets:
            package_map[target] = (path, targets)

    package_hint = Path(args.project).expanduser().resolve().name if (Path(args.project).expanduser().resolve() / "Package.swift").is_file() else None
    preferred_scheme = package_hint if package_hint in schemes else None
    selected_scheme = args.scheme or preferred_scheme or ask_choice("Which scheme do you want to run?", schemes, default_first=True)
    # In an Xcode project context, always run the selected Xcode scheme through Xcode.
    # A scheme can share its name with a local Swift package; routing that entry to
    # `swift test` runs on macOS and cannot use Xcode-only plugin APIs or a simulator.
    package = package_map.get(selected_scheme)
    choices_for_scheme = package[1] if package else test_targets(project_path, info, selected_scheme)
    selected_targets = list(dict.fromkeys(args.test_targets))
    unknown_targets = [target for target in selected_targets if choices_for_scheme and target not in choices_for_scheme]
    if unknown_targets:
        choices = ", ".join(choices_for_scheme)
        raise RuntimeError(
            f"Test target(s) {', '.join(repr(target) for target in unknown_targets)} are not in scheme '{selected_scheme}'. "
            f"Choose from: {choices}."
        )
    has_test_selectors = bool(args.test_files or args.suite or args.tests)
    if not selected_targets:
        if has_test_selectors:
            choices = ["No full test targets", *choices_for_scheme]
            selected_scope = ask_multiple_choices("Which full test target(s), if any, should be added?", choices)
            selected_targets = [target for target in selected_scope if target != choices[0]]
        elif choices_for_scheme:
            choices = ["All test targets in scheme", *choices_for_scheme]
            selected_scope = ask_multiple_choices("Which test target(s) do you want to run?", choices)
            selected_targets = [] if choices[0] in selected_scope else selected_scope

    task = {"kind": kind, "path": str(project_path), "scheme": selected_scheme, "targets": selected_targets}
    if selected_targets:
        task["name"] = f"{selected_scheme} / {', '.join(selected_targets)}"
    elif has_test_selectors:
        task["name"] = f"{selected_scheme} / selected tests"
    else:
        task["name"] = f"{selected_scheme} / all test targets"
    if package:
        package_path, _ = package
        task["source"] = str(package_path.relative_to(project_path.parent))
        print(f"[run] Running package {package_path.name} through Xcode on the selected simulator.", flush=True)
    tasks = [task]

    has_xcode_tasks = any(task["kind"] != "swift-package" for task in tasks)
    destination = None
    if has_xcode_tasks:
        if not args.destination:
            print("[run] Finding available iOS simulators…", flush=True)
        destination = args.destination or choose_destination()
    if kind != "swift-package":
        if has_test_selectors and selected_targets:
            print(f"Test scope: selected tests plus all tests in {', '.join(selected_targets)}", flush=True)
        elif has_test_selectors:
            print("Test scope: selected files, suites, and tests only", flush=True)
        elif selected_targets:
            print(f"Test scope: all tests in {', '.join(selected_targets)}", flush=True)
        else:
            print("Test scope: all test targets in the selected scheme's test plan", flush=True)

    task = tasks[0]
    output = args.output
    print("Test scope: full configured target" if not (args.test_files or args.suite or args.tests) else "Test scope: selected tests", flush=True)
    source_scope = args.source or ([task["source"]] if task.get("source") else [])
    print("Mutation scope: all discovered source files" if not source_scope else f"Mutation scope: {', '.join(source_scope)}", flush=True)
    return execute_task(task, args, destination, output)


def main() -> int:
    args = parser().parse_args()
    try:
        return run(args)
    except (RuntimeError, OSError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
